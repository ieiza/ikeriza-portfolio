---
// Renders a page from src/site/pages/<slug>.html verbatim.
// The <html> attributes (data-wf-page / data-wf-site) must stay on the root element
// because webflow.js uses them to run each page's interactions.
import { getSitePage } from '../site/pages';

interface Props { slug: string }
const { slug } = Astro.props;
const page = getSitePage(slug);
---
<html {...page.htmlAttrs}>
  <head><Fragment set:html={page.head} /></head>
  <body {...page.bodyAttrs}><Fragment set:html={page.body} /></body>
</html>
