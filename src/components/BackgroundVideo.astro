---
// Muted, looping, autoplaying video. Off-screen videos (and their poster
// frames) don't download until they come near the viewport — see
// scripts/site.ts — unless `eager` is set (used for the hero).
import { videoSources } from '../lib/media';

interface Props {
  src: string;
  eager?: boolean;
  filter?: string;
  class?: string;
}
const { src, eager = false, filter, class: className } = Astro.props;
const { mp4, poster } = videoSources(src);
---
<div class:list={['bg-video', className]} style={filter ? `filter:${filter}` : undefined}>
  <video
    muted
    loop
    playsinline
    disablepictureinpicture
    aria-hidden="true"
    autoplay={eager}
    preload={eager ? 'auto' : 'none'}
    data-bg-video={eager ? 'eager' : ''}
    poster={eager ? poster : undefined}
    data-poster={eager ? undefined : poster}
    src={mp4}
  ></video>
</div>
