---
// Responsive image: AVIF, then WebP, generated by scripts/optimize-images.mjs.
import { imageSet } from '../lib/media';

interface Props {
  src: string;
  alt?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt = '', sizes = '100vw', eager = false, class: className } = Astro.props;
const set = imageSet(src);
---
<picture>
  {set.avifSrcset && <source type="image/avif" srcset={set.avifSrcset} sizes={sizes} />}
  {set.webpSrcset && <source type="image/webp" srcset={set.webpSrcset} sizes={sizes} />}
  <img
    src={set.src}
    alt={alt}
    width={set.width}
    height={set.height}
    class={className}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</picture>
