---
import '@fontsource/victor-mono/latin-700-italic.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /** Analytics content group: home | project | about | not_found. */
  pageType: 'home' | 'project' | 'about' | 'not_found';
  description?: string;
  ogImage?: string;
  /** Hide the footer (used by the 404 page). */
  bare?: boolean;
  /** Extra schema.org data for this page (merged into the site's JSON-LD graph). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep this page out of search results. */
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Iker Iza is a New York creative director and designer: brand identity, packaging, websites, apps and campaigns for hospitality, CPG, finance, tech and more.';
const DEFAULT_OG_IMAGE = '/media/og/home.jpg'; // share images: npm run og

const { title, pageType, description = DEFAULT_DESCRIPTION, ogImage = DEFAULT_OG_IMAGE, bare = false, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const isProd = import.meta.env.PROD;

const siteUrl = new URL('/', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: 'Iker Iza',
  url: siteUrl,
  jobTitle: 'Creative Director',
  description: 'New York creative director and designer working in brand identity, packaging, web, apps, campaigns and events.',
  image: new URL('/media/og/about.jpg', Astro.site).href,
  knowsAbout: ['Brand identity', 'Creative direction', 'Art direction', 'Packaging design', 'Web design', 'App design', 'Advertising campaigns', 'Exhibition design'],
  email: 'mailto:hello@ikeriza.com',
  address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
  sameAs: ['https://www.linkedin.com/in/ikeriza/', 'https://www.instagram.com/iker.iza/'],
};
const website = { '@type': 'WebSite', '@id': `${siteUrl}#website`, url: siteUrl, name: 'Iker Iza', inLanguage: 'en', publisher: { '@id': person['@id'] } };
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [person, website, ...(schema ? [schema].flat() : [])] });
---
<!doctype html>
<html lang="en-US" data-page-type={pageType}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/media/6706c5da31673ad438e49a2f_5dc8d22011520e5f5eefd041_IzaFavicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/media/6706c5dfc8c10752d97ed7b7_5dc8d226d6571ec64bc8ed9d_IzaWebclip.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Adobe Fonts (obviously, obviously-wide). The kit must list every domain the site is served from. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lmi7yvo.css" />

    {isProd && (
      <>
        <!-- Vercel Web Analytics (cookieless visits) and Speed Insights (real-visitor Core Web Vitals). -->
        <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
        <script is:inline>window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };</script>
        <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
        <script is:inline>
          // Analytics (Google Analytics 4 + Ahrefs) only on the real domain, so previews and local builds don't skew the data.
          if (/(^|\.)ikeriza\.com$/.test(location.hostname)) {
            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=G-WQ92F84BL4';
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { dataLayer.push(arguments); };
            gtag('js', new Date());
            gtag('config', 'G-WQ92F84BL4', { content_group: document.documentElement.dataset.pageType });

            // Ahrefs Web Analytics (cookieless).
            const a = document.createElement('script');
            a.async = true;
            a.src = 'https://analytics.ahrefs.com/analytics.js';
            a.dataset.key = 'z8gFJ2JlZxTLvbpSDAxfyw';
            document.head.appendChild(a);
          }
        </script>
      </>
    )}
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
