---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import MediaItem from '../components/MediaItem.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { getProjects, nextProject, titleLines, excerpt, parseCredits, type Project } from '../lib/projects';
import { imageSet } from '../lib/media';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, next: nextProject(projects, project) },
  }));
}

const VIDEO_UPLOAD_DATE = '2026-11-06';

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const creditGroups = data.credits.trim().split(/\n\s*\n/).map((g) => g.split('\n'));

const name = titleLines(data.menuTitle).join('');
const pageTitle = data.seoTitle ?? (/iker iza/i.test(data.title) ? data.title : `${data.title} | Iker Iza`);
const description = data.description ?? excerpt(project.body ?? '');
const ogImage = `/media/og/${project.id}.jpg`; // generated by npm run og

// Structured data: the project, its place in the site (breadcrumbs) and any full-length videos.
const abs = (path: string) => new URL(path, Astro.site).href;
const pageUrl = abs(`/${project.id}`);
const { disciplines, studio, year, client } = parseCredits(data.credits);
const heroImage = 'image' in data.hero ? abs(imageSet(data.hero.image, 1600).src) : abs(ogImage);
const videos = data.rows.flatMap((row) => ('player' in row ? [row.player] : []));
const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name,
    headline: data.heading,
    description,
    url: pageUrl,
    image: [heroImage, abs(ogImage)],
    creator: { '@id': abs('/#person') },
    isPartOf: { '@id': abs('/#website') },
    inLanguage: 'en',
    ...(disciplines.length && { genre: disciplines, keywords: disciplines.join(', ') }),
    ...(year && { dateCreated: year }),
    ...(client && { about: { '@type': 'Organization', name: client } }),
    ...(studio && { producer: { '@type': 'Organization', name: studio } }),
    ...(videos.length && { video: videos.map((_, i) => ({ '@id': `${pageUrl}#video-${i + 1}` })) }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: abs('/') },
      { '@type': 'ListItem', position: 2, name, item: pageUrl },
    ],
  },
  ...videos.map((v, i) => ({
    '@type': 'VideoObject',
    '@id': `${pageUrl}#video-${i + 1}`,
    name: v.title.toLowerCase() === name.toLowerCase() ? `${name} — campaign video` : `${v.title} — ${name}`,
    description,
    thumbnailUrl: abs(v.poster ?? ogImage),
    contentUrl: abs(v.src),
    embedUrl: pageUrl,
    // Date the video was first published on this site (it moved here from Vimeo).
    uploadDate: VIDEO_UPLOAD_DATE,
    creator: { '@id': abs('/#person') },
  })),
];
---
<Base title={pageTitle} description={description} ogImage={ogImage} schema={schema}>
  <section class="project-hero">
    <div class="project-hero__media">
      {'image' in data.hero
        ? <Picture src={data.hero.image} alt={data.hero.alt} sizes="100vw" eager />
        : <BackgroundVideo src={data.hero.video} eager />}
    </div>
    <h1 class="project-hero__title">
      {titleLines(data.heroTitle).map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h1>
  </section>

  <div class="project-rows">
    {data.rows.map((row) =>
      'player' in row ? (
        <VideoPlayer {...row.player} />
      ) : (
        <div class:list={['media-row', `media-row--${row.columns}`, row.short && 'media-row--short']}>
          {row.items.map((item) => <MediaItem item={item} columns={row.columns} />)}
        </div>
      ),
    )}
  </div>

  <section class="details">
    <div class="details__column">
      <h2 class="details__heading">{data.heading}</h2>
      <div class="details__text"><Content /></div>
    </div>
    <div class="details__column details__column--credits">
      <h2 class="details__heading">{data.creditsHeading}</h2>
      <div class="details__text">
        {creditGroups.map((lines) => <p>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}
      </div>
    </div>
  </section>

  <nav class="page-nav" aria-label="Next project">
    <a href={`/${next.id}`} aria-label={`Next project: ${titleLines(next.data.menuTitle).join(' ')}`}>Next</a>
  </nav>
</Base>
