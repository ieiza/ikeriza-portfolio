---
import SitePage from '../components/SitePage.astro';
import { sitePages } from '../site/pages';

export function getStaticPaths() {
  return sitePages
    .filter((p) => p.slug !== '404')
    .map((p) => ({ params: { slug: p.slug === 'index' ? undefined : p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
---
<SitePage slug={slug} />
